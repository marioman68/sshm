#!/usr/bin/env bash

# ==============================================================================
# SSH Connection Hub (sshm)
# Lightweight, mouse-friendly TUI for managing remote SSH servers
# ==============================================================================

VERSION="2.0.3"
CONFIG_FILE="$HOME/.ssh_servers"
REMOTEVIEW_DIR="$HOME/.local/share/remoteview"
GTK_BOOKMARKS="$HOME/.config/gtk-3.0/bookmarks"
FILTER_TAG="ALL"

# Color Palette Definitions
C_RESET="\e[0m"
C_BOLD="\e[1m"
C_BORDER="\e[38;5;99m"      # Subtle purple/indigo window frame
C_HEADER="\e[38;5;213m"     # Bright neon magenta title
C_CYAN="\e[38;5;51m"
C_BLUE="\e[38;5;39m"
C_PURPLE="\e[38;5;141m"
C_GREEN="\e[38;5;82m"
C_YELLOW="\e[38;5;220m"
C_ORANGE="\e[38;5;208m"
C_RED="\e[38;5;196m"
C_MUTED="\e[38;5;244m"
BG_HOVER="\e[48;5;236m"     # Standard row hover highlight
BG_MNT_HOVER="\e[48;5;60m"  # Distinct purple-blue highlight for mount icon

RESIZE_TRIGGERED=0

enable_mouse() {
    printf "\e[?1003h\e[?1006h\e[?25l\e[?7l"
}

disable_mouse() {
    printf "\e[?1003l\e[?1006l\e[?25h\e[?7h"
    stty echo 2>/dev/null
    sleep 0.05
    local garbage
    while read -t 0.05 -rsn1 garbage; do : ; done
}

on_resize() {
    RESIZE_TRIGGERED=1
}

trap 'on_resize' WINCH
trap 'disable_mouse; clear; echo ""; exit' EXIT INT TERM

repeat_char() {
    local char="$1"
    local count="$2"
    local str=""
    for ((i=0; i<count; i++)); do
        str="${str}${char}"
    done
    echo -n "$str"
}

expand_path() {
    local p="$1"
    p="${p/#\~/$HOME}"
    echo "${p%/}"
}

# ==============================================================================
# MODULE 02: UI & Rendering Engine
# ==============================================================================

calc_geometry() {
    TERM_COLS=$(tput cols)
    TERM_LINES=$(tput lines)

    [ "$TERM_COLS" -lt 95 ] && TERM_COLS=95
    [ "$TERM_LINES" -lt 24 ] && TERM_LINES=24

    TOTAL_W=$(( TERM_COLS - 2 ))
    LEFT_START=1
    LEFT_END=$(( TOTAL_W / 2 ))
    RIGHT_START=$(( LEFT_END + 2 ))
    RIGHT_END=$TOTAL_W

    LEFT_INNER_W=$(( LEFT_END - LEFT_START - 1 ))
    RIGHT_INNER_W=$(( RIGHT_END - RIGHT_START - 1 ))

    CONTENT_H=$(( TERM_LINES - 9 ))
    [ "$CONTENT_H" -lt 11 ] && CONTENT_H=11

    ROW_TOP=1
    ROW_TWIN_TOP=4
    ROW_TWIN_START=5
    ROW_TWIN_END=$(( ROW_TWIN_START + CONTENT_H - 1 ))
    ROW_TWIN_BOTTOM=$(( ROW_TWIN_END + 1 ))

    ROW_LEGEND_SEP=$(( ROW_TWIN_BOTTOM - 3 ))
    ROW_LEGEND_TEXT_1=$(( ROW_TWIN_BOTTOM - 2 ))
    ROW_LEGEND_TEXT_2=$(( ROW_TWIN_BOTTOM - 1 ))

    ROW_PROMPT_TOP=$(( ROW_TWIN_BOTTOM + 1 ))
    ROW_PROMPT_INPUT=$(( ROW_PROMPT_TOP + 1 ))
    ROW_PROMPT_BOTTOM=$(( ROW_PROMPT_INPUT + 1 ))
}

draw_box() {
    local rs="$1"
    local re="$2"
    local cs="$3"
    local ce="$4"
    local width=$(( ce - cs - 1 ))
    local hline
    hline=$(repeat_char "─" "$width")

    printf "\e[%d;%dH${C_BORDER}╭%s╮${C_RESET}" "$rs" "$cs" "$hline"
    for ((r=rs+1; r<re; r++)); do
        printf "\e[%d;%dH${C_BORDER}│\e[%d;%dH│${C_RESET}" "$r" "$cs" "$r" "$ce"
    done
    printf "\e[%d;%dH${C_BORDER}╰%s╯${C_RESET}" "$re" "$cs" "$hline"
}

draw_separator() {
    local row="$1"
    local cs="$2"
    local ce="$3"
    local width=$(( ce - cs - 1 ))
    local hline
    hline=$(repeat_char "─" "$width")
    printf "\e[%d;%dH${C_BORDER}├%s┤${C_RESET}" "$row" "$cs" "$hline"
}

draw_wireframe() {
    clear
    calc_geometry

    draw_box "$ROW_TOP" "$((ROW_TOP + 2))" 1 "$TOTAL_W"
    draw_box "$ROW_TWIN_TOP" "$ROW_TWIN_BOTTOM" "$LEFT_START" "$LEFT_END"
    draw_box "$ROW_TWIN_TOP" "$ROW_TWIN_BOTTOM" "$RIGHT_START" "$RIGHT_END"
    draw_box "$ROW_PROMPT_TOP" "$ROW_PROMPT_BOTTOM" 1 "$TOTAL_W"

    draw_separator "$ROW_LEGEND_SEP" "$LEFT_START" "$LEFT_END"
}

draw_left_legend() {
    printf "\e[%d;%dH   ${C_GREEN}●${C_RESET} Online   ${C_RED}○${C_RESET} Offline   ${C_BLUE}◆${C_RESET} Mounted   ${C_MUTED}◇${C_RESET} Unmounted" "$ROW_LEGEND_TEXT_1" "$(( LEFT_START + 1 ))"
    printf "\e[%d;%dH   Click ${C_BLUE}◆${C_RESET}  /  ${C_MUTED}◇${C_RESET}  to toggle mount   Press [f] to filter tags" "$ROW_LEGEND_TEXT_2" "$(( LEFT_START + 1 ))"
}

temp_message() {
    prompt_in_dialog "$1"
    ( sleep 1.5 ) &
    local pid=$!
    local garbage
    while kill -0 $pid 2>/dev/null; do
        read -t 0.1 -rsn1 garbage
    done
}

prompt_in_dialog() {
    local prompt_str="$1"
    local prompt_len=${#prompt_str}
    local input_col=$(( 3 + prompt_len ))

    printf "\e[%d;2H%*s" "$ROW_PROMPT_INPUT" "$(( TOTAL_W - 2 ))" ""
    printf "\e[%d;%dH${C_BORDER}│${C_RESET}" "$ROW_PROMPT_INPUT" "$TOTAL_W"
    printf "\e[%d;3H%s\e[%d;%dH" "$ROW_PROMPT_INPUT" "$prompt_str" "$ROW_PROMPT_INPUT" "$input_col"
}

# hover_mode: 0 = none, 1 = standard row hover, 2 = mount icon hover
render_left_pane() {
    local row="$1"
    local hover_mode="$2"
    local idx=$(( row - ROW_TWIN_START ))

    local bg=""
    local m_bg=""
    if [ "$idx" -ge 0 ] && [ "$idx" -lt "$server_count" ]; then
        if [ "$hover_mode" -eq 1 ]; then
            bg="${BG_HOVER}"
            m_bg="${BG_HOVER}"
        elif [ "$hover_mode" -eq 2 ]; then
            bg="${BG_HOVER}"
            m_bg="${BG_MNT_HOVER}"
        fi
    fi

    printf "\e[%d;%dH" "$row" "$(( LEFT_START + 1 ))"
    if [ "$idx" -ge 0 ] && [ "$idx" -lt "$server_count" ]; then
        local num=$(( idx + 1 ))
        local name="${srv_names[$idx]}"
        local tag="${srv_tags[$idx]}"
        local st="${srv_online[$idx]}"
        local lat="${srv_latencies[$idx]}"
        local mnt="${srv_mounted[$idx]}"

        # Status dot on the left (keeps row bg intact)
        local s_icon="${C_RED}○${C_RESET}${bg}"
        local lat_str
        lat_str=$(printf "${C_MUTED}%6s${C_RESET}${bg}" "--")
        if [ "$st" == "ONLINE" ]; then
            s_icon="${C_GREEN}●${C_RESET}${bg}"
            lat_str=$(printf "${C_CYAN}%6s${C_RESET}${bg}" "$lat")
        fi

        # Mount diamond after status dot (gets distinct m_bg when hovered directly)
        local m_icon="${m_bg} ${C_MUTED}◇${C_RESET}${m_bg} ${C_RESET}${bg}"
        if [ "$mnt" -eq 1 ]; then
            m_icon="${m_bg} ${C_BLUE}◆${C_RESET}${m_bg} ${C_RESET}${bg}"
        fi

        local disp_name="$name"
        [ -n "$tag" ] && disp_name="$name [$tag]"

        local avail=$(( LEFT_INNER_W - 22 ))
        [ "$avail" -lt 10 ] && avail=10
        [ ${#disp_name} -gt "$avail" ] && disp_name="${disp_name:0:$((avail - 1))}…"

        local fill_w=$(( LEFT_INNER_W - 21 - ${#disp_name} ))
        [ "$fill_w" -lt 0 ] && fill_w=0

        printf "${bg}  %b%b${C_GREEN}[%2d]${C_RESET}${bg}  ${C_BOLD}%s${C_RESET}${bg}%*s%b ${C_RESET}" \
            "$s_icon" "$m_icon" "$num" "$disp_name" "$fill_w" "" "$lat_str"
    else
        printf "${bg}%*s${C_RESET}" "$LEFT_INNER_W" ""
    fi
    printf "\e[%d;%dH${C_BORDER}│${C_RESET}" "$row" "$LEFT_END"
}

render_right_pane() {
    local row="$1"
    local is_hover="$2"
    local act_idx=$(( row - ROW_TWIN_START ))

    local bg=""
    [ "$is_hover" -eq 1 ] && [ "$act_idx" -ge 0 ] && [ "$act_idx" -le 10 ] && bg="${BG_HOVER}"

    local col_start=$(( RIGHT_START + 1 ))
    printf "\e[%d;%dH" "$row" "$col_start"

    if [ "$act_idx" -ge 0 ] && [ "$act_idx" -le 10 ]; then
        local p1=""
        local p2=""
        local raw_text=""

        case "$act_idx" in
            0)  p1="${C_GREEN}[c]${C_RESET}${bg}";  p2="   Connect via SSH (Auto-tmux)"; raw_text="  [c]   Connect via SSH (Auto-tmux)" ;;
            1)  p1="${C_CYAN}[b]${C_RESET}${bg}";   p2="   Browse files in GUI File Manager"; raw_text="  [b]   Browse files in GUI File Manager" ;;
            2)  p1="${C_BLUE}[s]${C_RESET}${bg}";   p2="   Interactive SFTP shell"; raw_text="  [s]   Interactive SFTP shell" ;;
            3)  p1="${C_PURPLE}[t]${C_RESET}${bg}"; p2="   Port Tunneling (Local forward)"; raw_text="  [t]   Port Tunneling (Local forward)" ;;
            4)  p1="${C_ORANGE}[w]${C_RESET}${bg}"; p2="   Wake-on-LAN (Magic Packet)"; raw_text="  [w]   Wake-on-LAN (Magic Packet)" ;;
            5)  p1="${C_YELLOW}[k]${C_RESET}${bg}"; p2="   Push SSH Key (ssh-copy-id)"; raw_text="  [k]   Push SSH Key (ssh-copy-id)" ;;
            6)  p1="${C_GREEN}[a]${C_RESET}${bg}";  p2="   Add new server profile"; raw_text="  [a]   Add new server profile" ;;
            7)  p1="${C_CYAN}[e]${C_RESET}${bg}";   p2="   Edit server profile"; raw_text="  [e]   Edit server profile" ;;
            8)  p1="${C_RED}[d]${C_RESET}${bg}";    p2="   Delete server profile"; raw_text="  [d]   Delete server profile" ;;
            9)  p1="${C_BLUE}[r]${C_RESET}${bg}";   p2="   Refresh status & latencies"; raw_text="  [r]   Refresh status & latencies" ;;
            10) p1="${C_RED}[q]${C_RESET}${bg}";    p2="   Exit Console"; raw_text="  [q]   Exit Console" ;;
        esac

        local text_len=${#raw_text}
        local pad=$(( RIGHT_INNER_W - text_len ))
        [ "$pad" -lt 0 ] && pad=0

        printf "${bg}  %b%b${bg}%*s${C_RESET}" "$p1" "$p2" "$pad" ""
    else
        printf "${bg}%*s${C_RESET}" "$RIGHT_INNER_W" ""
    fi
    printf "\e[%d;%dH${C_BORDER}│${C_RESET}" "$row" "$RIGHT_END"
}

# ==============================================================================
# MODULE 03: Backend Logic (Mounts, Ping/TCP Latency & Config Loading)
# ==============================================================================

# Universal Desktop Environment Mount Check
is_mounted() {
    local name="$1"
    local user="$2"
    local host="$3"
    local port="$4"
    local safe_name="${name// /_}"

    if [[ "$XDG_CURRENT_DESKTOP" == *"KDE"* ]] || [ -d "$REMOTEVIEW_DIR" ]; then
        [ -f "$REMOTEVIEW_DIR/${safe_name}.desktop" ] && return 0
    fi
    if [ -f "$GTK_BOOKMARKS" ]; then
        grep -q "sftp://${user}@${host}:${port}" "$GTK_BOOKMARKS" 2>/dev/null && return 0
    fi
    return 1
}

toggle_mount() {
    local idx="$1"
    local name="${srv_names[$idx]}"
    local user="${srv_users[$idx]}"
    local host="${srv_hosts[$idx]}"
    local port="${srv_ports[$idx]}"
    local safe_name="${name// /_}"

    if is_mounted "$name" "$user" "$host" "$port"; then
        rm -f "$REMOTEVIEW_DIR/${safe_name}.desktop" 2>/dev/null
        if [ -f "$GTK_BOOKMARKS" ]; then
            sed -i "\|sftp://${user}@${host}:${port}|d" "$GTK_BOOKMARKS" 2>/dev/null
        fi
        temp_message "[  OK  ] Unmounted '$name' from Network Folders."
    else
        if [[ "$XDG_CURRENT_DESKTOP" == *"KDE"* ]] || command -v dolphin >/dev/null 2>&1; then
            mkdir -p "$REMOTEVIEW_DIR"
            cat <<EOF2 > "$REMOTEVIEW_DIR/${safe_name}.desktop"
[Desktop Entry]
Icon=folder-remote
Name=$name
Type=Link
URL=sftp://${user}@${host}:${port}/
EOF2
        else
            mkdir -p "$(dirname "$GTK_BOOKMARKS")"
            echo "sftp://${user}@${host}:${port}/ $name" >> "$GTK_BOOKMARKS"
        fi
        temp_message "[  OK  ] Mounted '$name' to Network Folders!"
    fi
}

measure_latency() {
    local host="$1"
    local port="$2"
    local rtt=""

    rtt=$(ping -c 1 -W 1 "$host" 2>/dev/null | awk -F'time=' '/time=/ {split($2, a, " "); print int(a[1]+0.5)"ms"}')
    if [ -n "$rtt" ]; then
        echo "ONLINE|$rtt"
        return
    fi

    if timeout 1 bash -c "</dev/tcp/$host/$port" 2>/dev/null; then
        echo "ONLINE|TCP"
    else
        echo "OFFLINE|--"
    fi
}

load_servers() {
    touch "$CONFIG_FILE"
    all_lines=()
    unique_tags=("ALL")

    while IFS= read -r line || [ -n "$line" ]; do
        [[ -z "$line" || "$line" =~ ^# ]] && continue
        all_lines+=("$line")
        IFS='|' read -r _ _ _ _ tag _ _ <<< "$line"
        if [ -n "$tag" ]; then
            local found=0
            for t in "${unique_tags[@]}"; do
                [ "$t" == "$tag" ] && found=1 && break
            done
            [ "$found" -eq 0 ] && unique_tags+=("$tag")
        fi
    done < "$CONFIG_FILE"

    srv_real_idx=()
    srv_names=()
    srv_users=()
    srv_hosts=()
    srv_ports=()
    srv_tags=()
    srv_macs=()
    srv_keys=()
    srv_online=()
    srv_latencies=()
    srv_mounted=()

    local tmp_dir
    tmp_dir=$(mktemp -d)

    local disp_i=0
    for i in "${!all_lines[@]}"; do
        IFS='|' read -r name user host port tag mac key <<< "${all_lines[$i]}"
        [ -z "$port" ] && port=22

        if [ "$FILTER_TAG" != "ALL" ] && [ "$tag" != "$FILTER_TAG" ]; then
            continue
        fi

        srv_real_idx+=("$i")
        srv_names+=("$name")
        srv_users+=("$user")
        srv_hosts+=("$host")
        srv_ports+=("$port")
        srv_tags+=("$tag")
        srv_macs+=("$mac")
        srv_keys+=("$key")

        if is_mounted "$name" "$user" "$host" "$port"; then
            srv_mounted+=("1")
        else
            srv_mounted+=("0")
        fi

        (
            measure_latency "$host" "$port" > "$tmp_dir/$disp_i"
        ) &

        disp_i=$(( disp_i + 1 ))
    done

    wait

    server_count=$disp_i
    for ((j=0; j<server_count; j++)); do
        if [ -f "$tmp_dir/$j" ]; then
            IFS='|' read -r st lat < "$tmp_dir/$j"
            srv_online+=("$st")
            srv_latencies+=("$lat")
        else
            srv_online+=("OFFLINE")
            srv_latencies+=("--")
        fi
    done

    rm -rf "$tmp_dir"
}

# ==============================================================================
# MODULE 04: User Actions & Workflows
# ==============================================================================

connect_ssh() {
    local idx="$1"
    local name="${srv_names[$idx]}"
    local user="${srv_users[$idx]}"
    local host="${srv_hosts[$idx]}"
    local port="${srv_ports[$idx]}"
    local key="${srv_keys[$idx]}"

    disable_mouse
    clear
    echo -e "${C_HEADER}${C_BOLD}◆ CONNECTING TO: ${name} (${user}@${host}:${port})${C_RESET}\n"

    local ssh_opts=("-p" "$port")
    if [ -n "$key" ]; then
        local exp_key
        exp_key=$(expand_path "$key")
        [ -f "$exp_key" ] && ssh_opts+=("-i" "$exp_key")
    fi

    echo -ne "${C_YELLOW}[INPUT] Auto-attach to remote tmux session if available? (y/N): ${C_RESET}"
    read -r use_tmux
    echo ""

    if [[ "$use_tmux" =~ ^[Yy]$ ]]; then
        ssh -t "${ssh_opts[@]}" "${user}@${host}" "tmux attach || tmux new || \$SHELL"
    else
        ssh "${ssh_opts[@]}" "${user}@${host}"
    fi
}

browse_gui() {
    local idx="$1"
    local name="${srv_names[$idx]}"
    local user="${srv_users[$idx]}"
    local host="${srv_hosts[$idx]}"
    local port="${srv_ports[$idx]}"
    local url="sftp://${user}@${host}:${port}/"

    if command -v xdg-open >/dev/null 2>&1; then
        xdg-open "$url" &>/dev/null &
        temp_message "[  OK  ] Opening '$name' in GUI file manager..."
    elif command -v dolphin >/dev/null 2>&1; then
        dolphin "$url" &>/dev/null &
        temp_message "[  OK  ] Opening '$name' in Dolphin..."
    else
        temp_message "[ FAIL ] No compatible GUI file manager opener found."
    fi
}

connect_sftp() {
    local idx="$1"
    local name="${srv_names[$idx]}"
    local user="${srv_users[$idx]}"
    local host="${srv_hosts[$idx]}"
    local port="${srv_ports[$idx]}"
    local key="${srv_keys[$idx]}"

    disable_mouse
    clear
    echo -e "${C_HEADER}${C_BOLD}◆ SFTP SESSION: ${name}${C_RESET}\n"

    local sftp_opts=("-P" "$port")
    if [ -n "$key" ]; then
        local exp_key
        exp_key=$(expand_path "$key")
        [ -f "$exp_key" ] && sftp_opts+=("-i" "$exp_key")
    fi

    sftp "${sftp_opts[@]}" "${user}@${host}"
}

port_tunnel_flow() {
    local idx="$1"
    local name="${srv_names[$idx]}"
    local user="${srv_users[$idx]}"
    local host="${srv_hosts[$idx]}"
    local port="${srv_ports[$idx]}"
    local key="${srv_keys[$idx]}"

    disable_mouse
    clear
    echo -e "${C_HEADER}${C_BOLD}◆ BACKGROUND PORT TUNNELING: ${name}${C_RESET}\n"
    echo -ne "${C_YELLOW}[INPUT] Local port to bind (e.g. 8080): ${C_RESET}"
    read -erp "" lport
    echo -ne "${C_YELLOW}[INPUT] Remote target port (e.g. 80): ${C_RESET}"
    read -erp "" rport

    if [[ -z "$lport" || -z "$rport" ]]; then
        echo -e "\n${C_RED}[ FAIL ] Ports cannot be empty.${C_RESET}"
        sleep 1.5
        return
    fi

    local ssh_opts=("-p" "$port" "-f" "-N" "-L" "${lport}:localhost:${rport}")
    if [ -n "$key" ]; then
        local exp_key
        exp_key=$(expand_path "$key")
        [ -f "$exp_key" ] && ssh_opts+=("-i" "$exp_key")
    fi

    echo -e "\n${C_CYAN}[ INFO ] Establishing background tunnel (localhost:${lport} -> ${host}:${rport})...${C_RESET}"
    if ssh "${ssh_opts[@]}" "${user}@${host}"; then
        echo -e "${C_GREEN}${C_BOLD}[  OK  ] Tunnel active in background!${C_RESET}"
    else
        echo -e "${C_RED}${C_BOLD}[ FAIL ] Could not establish port tunnel.${C_RESET}"
    fi
    echo -ne "\n${C_MUTED}Press Enter to return to hub...${C_RESET}"
    read -r
}

wake_on_lan_flow() {
    local idx="$1"
    local name="${srv_names[$idx]}"
    local mac="${srv_macs[$idx]}"

    if [ -z "$mac" ]; then
        temp_message "[ FAIL ] No MAC address saved for '$name'. Edit profile first."
        return
    fi

    if command -v wakeonlan >/dev/null 2>&1; then
        wakeonlan "$mac" >/dev/null 2>&1
        temp_message "[  OK  ] Magic packet sent to $name ($mac)!"
    elif command -v wol >/dev/null 2>&1; then
        wol "$mac" >/dev/null 2>&1
        temp_message "[  OK  ] Magic packet sent to $name ($mac)!"
    elif command -v python3 >/dev/null 2>&1; then
        python3 -c "
import socket
mac = '$mac'.replace(':', '').replace('-', '')
data = bytes.fromhex('FF' * 6 + mac * 16)
s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
s.setsockopt(socket.SOL_SOCKET, socket.SO_BROADCAST, 1)
s.sendto(data, ('255.255.255.255', 9))
" 2>/dev/null
        temp_message "[  OK  ] Magic packet sent via UDP broadcast to $mac!"
    else
        temp_message "[ FAIL ] No WoL tool or python3 available."
    fi
}

push_ssh_key_flow() {
    local idx="$1"
    local name="${srv_names[$idx]}"
    local user="${srv_users[$idx]}"
    local host="${srv_hosts[$idx]}"
    local port="${srv_ports[$idx]}"
    local key="${srv_keys[$idx]}"

    disable_mouse
    clear
    echo -e "${C_HEADER}${C_BOLD}◆ PUSH SSH KEY TO: ${name}${C_RESET}\n"
    echo -e "${C_MUTED}(Tip: Press [Tab] to auto-complete file paths)${C_RESET}"
    echo -ne "${C_YELLOW}[INPUT] SSH Public Key path [Default: ${key:-~/.ssh/id_ed25519.pub}]: ${C_RESET}"
    read -erp "" custom_key

    local target_key="${custom_key:-$key}"
    local copy_opts=("-p" "$port")
    if [ -n "$target_key" ]; then
        local exp_key
        exp_key=$(expand_path "$target_key")
        copy_opts+=("-i" "$exp_key")
    fi

    echo ""
    ssh-copy-id "${copy_opts[@]}" "${user}@${host}"
    echo -ne "\n${C_MUTED}Press Enter to return to hub...${C_RESET}"
    read -r
}

add_server_flow() {
    disable_mouse
    clear
    echo -e "${C_HEADER}${C_BOLD}◆ ADD NEW SERVER PROFILE${C_RESET}\n"

    echo -ne "${C_YELLOW}Friendly Name: ${C_RESET}"
    read -erp "" name
    [ -z "$name" ] && return

    echo -ne "${C_YELLOW}Username: ${C_RESET}"
    read -erp "" user
    [ -z "$user" ] && return

    echo -ne "${C_YELLOW}Host / IP Address: ${C_RESET}"
    read -erp "" host
    [ -z "$host" ] && return

    echo -ne "${C_YELLOW}SSH Port [Default: 22]: ${C_RESET}"
    read -erp "" port
    [ -z "$port" ] && port=22

    echo -ne "${C_YELLOW}Tag / Category (optional, e.g. Homelab): ${C_RESET}"
    read -erp "" tag

    echo -ne "${C_YELLOW}MAC Address for WoL (optional, XX:XX:XX:XX:XX:XX): ${C_RESET}"
    read -erp "" mac

    echo -e "${C_MUTED}(Tip: Press [Tab] to auto-complete key path)${C_RESET}"
    echo -ne "${C_YELLOW}SSH Private Key Path (optional): ${C_RESET}"
    read -erp "" key

    echo "${name}|${user}|${host}|${port}|${tag}|${mac}|${key}" >> "$CONFIG_FILE"
    echo -e "\n${C_GREEN}[  OK  ] Server '$name' saved!${C_RESET}"
    sleep 1
}

edit_server_flow() {
    local idx="$1"
    local real_idx="${srv_real_idx[$idx]}"

    IFS='|' read -r c_name c_user c_host c_port c_tag c_mac c_key <<< "${all_lines[$real_idx]}"
    [ -z "$c_port" ] && c_port=22

    disable_mouse
    clear
    echo -e "${C_HEADER}${C_BOLD}◆ EDIT SERVER PROFILE: ${c_name}${C_RESET}\n"
    echo -e "${C_MUTED}(Edit values below or press Enter to accept current value)${C_RESET}\n"

    read -erp "Friendly Name: " -i "$c_name" name
    read -erp "Username: " -i "$c_user" user
    read -erp "Host / IP: " -i "$c_host" host
    read -erp "SSH Port: " -i "$c_port" port
    read -erp "Tag / Category: " -i "$c_tag" tag
    read -erp "MAC Address: " -i "$c_mac" mac
    echo -e "${C_MUTED}(Tip: Press [Tab] to auto-complete key path)${C_RESET}"
    read -erp "SSH Key Path: " -i "$c_key" key

    all_lines[$real_idx]="${name}|${user}|${host}|${port:-22}|${tag}|${mac}|${key}"
    printf "%s\n" "${all_lines[@]}" > "$CONFIG_FILE"

    echo -e "\n${C_GREEN}[  OK  ] Profile updated!${C_RESET}"
    sleep 1
}

delete_server_flow() {
    local idx="$1"
    local real_idx="${srv_real_idx[$idx]}"
    local name="${srv_names[$idx]}"

    prompt_in_dialog "Delete '$name'? Type [y] to confirm: "
    read -r confirm
    if [[ "$confirm" =~ ^[Yy]$ ]]; then
        unset 'all_lines[real_idx]'
        if [ "${#all_lines[@]}" -eq 0 ]; then
            > "$CONFIG_FILE"
        else
            printf "%s\n" "${all_lines[@]}" > "$CONFIG_FILE"
        fi
        temp_message "[  OK  ] Deleted '$name'."
    else
        temp_message "[ INFO ] Deletion cancelled."
    fi
}

cycle_filter_tag() {
    local count=${#unique_tags[@]}
    [ "$count" -le 1 ] && return
    local next_idx=0
    for i in "${!unique_tags[@]}"; do
        if [ "${unique_tags[$i]}" == "$FILTER_TAG" ]; then
            next_idx=$(( (i + 1) % count ))
            break
        fi
    done
    FILTER_TAG="${unique_tags[$next_idx]}"
}

prompt_server_index() {
    local prompt_msg="$1"
    if [ "$server_count" -eq 0 ]; then
        temp_message "[ FAIL ] No servers available in current view."
        return 255
    fi
    prompt_in_dialog "$prompt_msg [1-$server_count]: "
    local num
    read -r num
    if [[ "$num" =~ ^[0-9]+$ ]] && [ "$num" -ge 1 ] && [ "$num" -le "$server_count" ]; then
        return $(( num - 1 ))
    else
        temp_message "[ FAIL ] Invalid server selection."
        return 255
    fi
}

# ==============================================================================
# MODULE 05: Main Interactive Loop & Event Dispatcher
# ==============================================================================

while true; do
    load_servers
    enable_mouse
    RESIZE_TRIGGERED=0

    draw_wireframe

    printf "\e[2;3H${C_HEADER}${C_BOLD}◆ SSH CONNECTION HUB (v${VERSION})${C_RESET}"
    printf "\e[2;%dH${C_MUTED}Filter: [${C_CYAN}%s${C_MUTED}]${C_RESET}" "$(( TOTAL_W - ${#FILTER_TAG} - 12 ))" "$FILTER_TAG"
    printf "\e[2;%dH${C_BORDER}│${C_RESET}" "$TOTAL_W"

    printf "\e[%d;4H${C_CYAN}${C_BOLD} REMOTE NODES (${server_count}) ${C_RESET}" "$ROW_TWIN_TOP"
    printf "\e[%d;%dH${C_HEADER}${C_BOLD} ACTION CENTER ${C_RESET}" "$ROW_TWIN_TOP" "$(( RIGHT_START + 3 ))"

    printf "\e[%d;4H${C_YELLOW}${C_BOLD} STATUS & QUICK LAUNCH ${C_RESET}" "$ROW_PROMPT_TOP"
    printf "\e[%d;3HType node [1-%d], action key, [f]ilter, or [q] to exit: \e[%d;%dH${C_BORDER}│${C_RESET}" \
        "$ROW_PROMPT_INPUT" "$server_count" "$ROW_PROMPT_INPUT" "$TOTAL_W"

    for ((r=ROW_TWIN_START; r<=ROW_TWIN_END; r++)); do
        if [ "$r" -lt "$ROW_LEGEND_SEP" ]; then
            render_left_pane "$r" 0
        fi
        render_right_pane "$r" 0
    done

    draw_left_legend

    active_hover_side=""
    active_hover_row=0
    active_hover_mode=0
    choice=""
    clicked_mount_idx=-1

    printf "\e[%d;60H" "$ROW_PROMPT_INPUT"

    while true; do
        if [ "$RESIZE_TRIGGERED" -eq 1 ]; then
            choice="r"
            break
        fi

        char=""
        if IFS= read -rsn1 -t 1 char; then
            if [[ "$char" == $'\e' ]]; then
                read -rsn2 -t 0.05 seq
                if [[ "$seq" == "[<" ]]; then
                    mouse_event=""
                    while IFS= read -rsn1 mchar; do
                        mouse_event+="$mchar"
                        [[ "$mchar" == "M" || "$mchar" == "m" ]] && break
                    done

                    if [[ "$mouse_event" =~ ^([0-9]+)\;([0-9]+)\;([0-9]+)([Mm])$ ]]; then
                        btn="${BASH_REMATCH[1]}"
                        cx="${BASH_REMATCH[2]}"
                        cy="${BASH_REMATCH[3]}"
                        action="${BASH_REMATCH[4]}"

                        side=""
                        new_hover_mode=1
                        if [ "$cy" -ge "$ROW_TWIN_START" ] && [ "$cy" -le "$ROW_TWIN_END" ]; then
                            if [ "$cx" -ge 2 ] && [ "$cx" -le "$LEFT_END" ]; then
                                if [ "$cy" -lt "$ROW_LEGEND_SEP" ]; then
                                    side="L"
                                    # Columns 5 to 7 correspond to the mount diamond area
                                    if [ "$cx" -ge 5 ] && [ "$cx" -le 7 ]; then
                                        new_hover_mode=2
                                    fi
                                fi
                            elif [ "$cx" -ge "$RIGHT_START" ] && [ "$cx" -le "$RIGHT_END" ]; then
                                side="R"
                            fi
                        fi

                        if [ -n "$side" ]; then
                            redraw=0
                            if [ "$side" != "$active_hover_side" ] || [ "$cy" -ne "$active_hover_row" ] || [ "$new_hover_mode" -ne "$active_hover_mode" ]; then
                                redraw=1
                            fi

                            if [ "$redraw" -eq 1 ]; then
                                if [ "$active_hover_side" == "L" ] && [ "$active_hover_row" -ge "$ROW_TWIN_START" ] && [ "$active_hover_row" -ne "$cy" ]; then
                                    render_left_pane "$active_hover_row" 0
                                fi
                                if [ "$active_hover_side" == "R" ] && [ "$active_hover_row" -ge "$ROW_TWIN_START" ] && [ "$active_hover_row" -ne "$cy" ]; then
                                    render_right_pane "$active_hover_row" 0
                                fi
                                if [ "$active_hover_side" != "$side" ]; then
                                    [ "$active_hover_side" == "L" ] && [ "$active_hover_row" -ge "$ROW_TWIN_START" ] && render_left_pane "$active_hover_row" 0
                                    [ "$active_hover_side" == "R" ] && [ "$active_hover_row" -ge "$ROW_TWIN_START" ] && render_right_pane "$active_hover_row" 0
                                fi

                                [ "$side" == "L" ] && render_left_pane "$cy" "$new_hover_mode"
                                [ "$side" == "R" ] && render_right_pane "$cy" 1

                                active_hover_side="$side"
                                active_hover_row="$cy"
                                active_hover_mode="$new_hover_mode"
                                printf "\e[%d;60H" "$ROW_PROMPT_INPUT"
                            fi
                        else
                            if [ -n "$active_hover_side" ]; then
                                [ "$active_hover_side" == "L" ] && [ "$active_hover_row" -ge "$ROW_TWIN_START" ] && render_left_pane "$active_hover_row" 0
                                [ "$active_hover_side" == "R" ] && [ "$active_hover_row" -ge "$ROW_TWIN_START" ] && render_right_pane "$active_hover_row" 0
                                active_hover_side=""
                                active_hover_row=0
                                active_hover_mode=0
                                printf "\e[%d;60H" "$ROW_PROMPT_INPUT"
                            fi
                        fi

                        if [ "$btn" -eq 0 ] && [ "$action" == "M" ]; then
                            if [ "$side" == "L" ]; then
                                clicked_idx=$(( cy - ROW_TWIN_START ))
                                if [ "$clicked_idx" -ge 0 ] && [ "$clicked_idx" -lt "$server_count" ]; then
                                    # Click on mount diamond (cols 5-7) toggles mount
                                    if [ "$cx" -ge 5 ] && [ "$cx" -le 7 ]; then
                                        clicked_mount_idx=$clicked_idx
                                        choice="MOUNT_TOGGLE"
                                        break
                                    else
                                        choice="$(( clicked_idx + 1 ))"
                                        break
                                    fi
                                fi
                            elif [ "$side" == "R" ]; then
                                case $(( cy - ROW_TWIN_START )) in
                                    0)  choice="c"; break ;;
                                    1)  choice="b"; break ;;
                                    2)  choice="s"; break ;;
                                    3)  choice="t"; break ;;
                                    4)  choice="w"; break ;;
                                    5)  choice="k"; break ;;
                                    6)  choice="a"; break ;;
                                    7)  choice="e"; break ;;
                                    8)  choice="d"; break ;;
                                    9)  choice="r"; break ;;
                                    10) choice="q"; break ;;
                                esac
                            fi
                        fi
                    fi
                fi
            elif [[ "$char" =~ ^[0-9a-zA-Z]$ ]]; then
                choice="$char"
                break
            fi
        fi
    done

    disable_mouse

    case "$choice" in
        [Qq])
            clear
            exit 0
            ;;
        [Rr])
            continue
            ;;
        [Ff])
            cycle_filter_tag
            ;;
        MOUNT_TOGGLE)
            [ "$clicked_mount_idx" -ge 0 ] && toggle_mount "$clicked_mount_idx"
            ;;
        [Cc])
            prompt_server_index "Enter server number to connect"
            idx=$?
            [ "$idx" -ne 255 ] && connect_ssh "$idx"
            ;;
        [Bb])
            prompt_server_index "Enter server number to browse"
            idx=$?
            [ "$idx" -ne 255 ] && browse_gui "$idx"
            ;;
        [Ss])
            prompt_server_index "Enter server number for SFTP"
            idx=$?
            [ "$idx" -ne 255 ] && connect_sftp "$idx"
            ;;
        [Tt])
            prompt_server_index "Enter server number for Port Tunnel"
            idx=$?
            [ "$idx" -ne 255 ] && port_tunnel_flow "$idx"
            ;;
        [Ww])
            prompt_server_index "Enter server number to Wake-on-LAN"
            idx=$?
            [ "$idx" -ne 255 ] && wake_on_lan_flow "$idx"
            ;;
        [Kk])
            prompt_server_index "Enter server number to push SSH key"
            idx=$?
            [ "$idx" -ne 255 ] && push_ssh_key_flow "$idx"
            ;;
        [Aa])
            add_server_flow
            ;;
        [Ee])
            prompt_server_index "Enter server number to edit"
            idx=$?
            [ "$idx" -ne 255 ] && edit_server_flow "$idx"
            ;;
        [Dd])
            prompt_server_index "Enter server number to delete"
            idx=$?
            [ "$idx" -ne 255 ] && delete_server_flow "$idx"
            ;;
        *)
            if [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -le "$server_count" ]; then
                connect_ssh $(( choice - 1 ))
            fi
            ;;
    esac
done

