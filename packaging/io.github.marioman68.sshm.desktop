[Desktop Entry]
Type=Application
Name=SSH Connection Hub
GenericName=SSH Server Manager
Comment=Manage SSH servers, tunnels, SFTP mounts and live server telemetry
Exec=sshm-gui
Icon=sshm
Terminal=false
Categories=Network;RemoteAccess;System;
Keywords=ssh;sftp;sshfs;server;homelab;tunnel;wake-on-lan;telemetry;terminal;
StartupNotify=true
StartupWMClass=sshm
Actions=Tray;Terminal;

[Desktop Action Tray]
Name=Start in tray
Exec=sshm-tray

[Desktop Action Terminal]
Name=Open terminal UI
Exec=sshm
Terminal=true
